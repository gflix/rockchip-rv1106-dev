+static inline bool is_des_mode(u32 rk_mode)
+{
+	return (rk_mode == RK_MODE_ECB ||
+		rk_mode == RK_MODE_CBC ||
+		rk_mode == RK_MODE_CFB ||
+		rk_mode == RK_MODE_OFB);
+}
