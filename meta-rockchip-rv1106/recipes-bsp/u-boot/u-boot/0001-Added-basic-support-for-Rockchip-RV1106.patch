diff --git a/drivers/net/dwc_eth_qos_rockchip_rv1106.c b/drivers/net/dwc_eth_qos_rockchip_rv1106.c
new file mode 100644
index 00000000000..b22aa65778c
--- /dev/null
+++ b/drivers/net/dwc_eth_qos_rockchip_rv1106.c
@@ -0,0 +1,250 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Synopsys DWC Ethernet QOS platform glue for Rockchip RV1106
+ *
+ * Copyright (c) 2024-2026 Felix Mellmann <flix@benfm.de>
+ *
+ * Handles: CRU clock enable, GRF RMII mode, integrated PHY power-up,
+ * RMII clock divider for 10/100 Mbps.
+ */
+
+#include <clk.h>
+#include <dm.h>
+#include <errno.h>
+#include <log.h>
+#include <malloc.h>
+#include <memalign.h>
+#include <net.h>
+#include <phy.h>
+#include <reset.h>
+#include <syscon.h>
+#include <asm/arch-rockchip/clock.h>
+#include <asm/arch-rockchip/hardware.h>
+#include <asm/arch-rockchip/grf_rv1106.h>
+#include <asm/cache.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+
+#include "dwc_eth_qos.h"
+
+/* GRF gmac_clk_con bits */
+#define RV1106_GMAC_CLK_RMII_MODE		BIT(0)
+#define RV1106_GMAC_CLK_RMII_DIV_MASK		GENMASK(3, 2)
+#define RV1106_GMAC_CLK_RMII_DIV2		BIT(2)
+#define RV1106_GMAC_CLK_RMII_DIV20		0
+
+/* GRF macphy_con0 bits */
+#define RV1106_MACPHY_ENABLE_MASK		BIT(1)
+#define RV1106_MACPHY_ENABLE			0
+#define RV1106_MACPHY_XMII_SEL_MASK		GENMASK(6, 5)
+#define RV1106_MACPHY_XMII_SEL			BIT(6)
+#define RV1106_MACPHY_24M_CLK_SEL_MASK		GENMASK(9, 7)
+#define RV1106_MACPHY_24M_CLK_SEL_24M		(BIT(8) | BIT(9))
+#define RV1106_MACPHY_PHY_ID_MASK		GENMASK(14, 10)
+#define RV1106_MACPHY_PHY_ID			BIT(11)
+
+struct eqos_rockchip_regs {
+	struct rv1106_grf *grf;
+	struct reset_ctl phy_reset;
+};
+
+static int eqos_probe_resources_rockchip(struct udevice *dev)
+{
+	struct eqos_priv *eqos = dev_get_priv(dev);
+	struct eqos_rockchip_regs *rk;
+	int ret;
+
+	ret = eqos_get_base_addr_dt(dev);
+	if (ret)
+		return ret;
+
+	rk = calloc(1, sizeof(*rk));
+	if (!rk)
+		return -ENOMEM;
+
+	rk->grf = syscon_get_first_range(ROCKCHIP_SYSCON_GRF);
+	if (IS_ERR(rk->grf)) {
+		free(rk);
+		return PTR_ERR(rk->grf);
+	}
+
+	/* Get CRU clocks */
+	ret = clk_get_by_name(dev, "aclk_mac", &eqos->clk_master_bus);
+	if (ret)
+		debug("rv1106-gmac: no aclk_mac (ret=%d)\n", ret);
+
+	ret = clk_get_by_name(dev, "pclk_mac", &eqos->clk_slave_bus);
+	if (ret)
+		debug("rv1106-gmac: no pclk_mac (ret=%d)\n", ret);
+
+	ret = clk_get_by_name(dev, "stmmaceth", &eqos->clk_tx);
+	if (ret)
+		debug("rv1106-gmac: no stmmaceth (ret=%d)\n", ret);
+
+	ret = clk_get_by_name(dev, "clk_mac_ref", &eqos->clk_rx);
+	if (ret)
+		debug("rv1106-gmac: no clk_mac_ref (ret=%d)\n", ret);
+
+	/* MAC reset */
+	ret = reset_get_by_name(dev, "stmmaceth", &eqos->reset_ctl);
+	if (ret)
+		debug("rv1106-gmac: no stmmaceth reset (ret=%d)\n", ret);
+
+	/* Integrated PHY reset via phy-handle subnode */
+	{
+		ofnode phy_node = ofnode_null();
+		u32 phy_phandle;
+
+		if (!dev_read_u32(dev, "phy-handle", &phy_phandle))
+			phy_node = ofnode_get_by_phandle(phy_phandle);
+		if (ofnode_valid(phy_node))
+			reset_get_by_index_nodev(phy_node, 0, &rk->phy_reset);
+	}
+
+	eqos->tegra186_regs = (void *)rk;
+
+	return 0;
+}
+
+static int eqos_remove_resources_rockchip(struct udevice *dev)
+{
+	struct eqos_priv *eqos = dev_get_priv(dev);
+
+	free(eqos->tegra186_regs);
+	eqos->tegra186_regs = NULL;
+	return 0;
+}
+
+static int eqos_start_clks_rockchip(struct udevice *dev)
+{
+	struct eqos_priv *eqos = dev_get_priv(dev);
+	struct eqos_rockchip_regs *rk = (void *)eqos->tegra186_regs;
+
+	/*
+	 * Enable CRU clocks so MAC registers are accessible.
+	 * The clk_enable() calls are no-ops (CRU driver doesn't implement
+	 * gate ops for MAC clocks), but kept for documentation/future use.
+	 */
+	clk_enable(&eqos->clk_master_bus);
+	clk_enable(&eqos->clk_slave_bus);
+	clk_enable(&eqos->clk_tx);
+	clk_enable(&eqos->clk_rx);
+
+	/* Set RMII mode */
+	rk_clrsetreg(&rk->grf->gmac_clk_con,
+		     RV1106_GMAC_CLK_RMII_MODE,
+		     RV1106_GMAC_CLK_RMII_MODE);
+
+	/* Power up integrated PHY */
+	if (reset_valid(&rk->phy_reset)) {
+		reset_assert(&rk->phy_reset);
+		udelay(20);
+
+		rk_clrsetreg(&rk->grf->macphy_con0,
+			     RV1106_MACPHY_ENABLE_MASK |
+			     RV1106_MACPHY_XMII_SEL_MASK |
+			     RV1106_MACPHY_24M_CLK_SEL_MASK |
+			     RV1106_MACPHY_PHY_ID_MASK,
+			     RV1106_MACPHY_ENABLE |
+			     RV1106_MACPHY_XMII_SEL |
+			     RV1106_MACPHY_24M_CLK_SEL_24M |
+			     RV1106_MACPHY_PHY_ID);
+
+		udelay(20);
+		reset_deassert(&rk->phy_reset);
+		mdelay(30);
+	}
+
+	return 0;
+}
+
+static int eqos_stop_clks_rockchip(struct udevice *dev)
+{
+	struct eqos_priv *eqos = dev_get_priv(dev);
+
+	clk_disable(&eqos->clk_rx);
+	clk_disable(&eqos->clk_tx);
+	clk_disable(&eqos->clk_slave_bus);
+	clk_disable(&eqos->clk_master_bus);
+	return 0;
+}
+
+static int eqos_start_resets_rockchip(struct udevice *dev)
+{
+	struct eqos_priv *eqos = dev_get_priv(dev);
+
+	if (reset_valid(&eqos->reset_ctl))
+		reset_deassert(&eqos->reset_ctl);
+	return 0;
+}
+
+static int eqos_stop_resets_rockchip(struct udevice *dev)
+{
+	struct eqos_priv *eqos = dev_get_priv(dev);
+
+	if (reset_valid(&eqos->reset_ctl))
+		reset_assert(&eqos->reset_ctl);
+	return 0;
+}
+
+static int eqos_set_tx_clk_speed_rockchip(struct udevice *dev)
+{
+	struct eqos_priv *eqos = dev_get_priv(dev);
+	struct eqos_rockchip_regs *rk = (void *)eqos->tegra186_regs;
+	unsigned int div;
+
+	switch (eqos->phy->speed) {
+	case SPEED_10:
+		div = RV1106_GMAC_CLK_RMII_DIV20;
+		break;
+	case SPEED_100:
+		div = RV1106_GMAC_CLK_RMII_DIV2;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	rk_clrsetreg(&rk->grf->gmac_clk_con,
+		     RV1106_GMAC_CLK_RMII_DIV_MASK, div);
+	return 0;
+}
+
+static ulong eqos_get_tick_clk_rate_rockchip(struct udevice *dev)
+{
+	return 100000000; /* pclk_mac = 100 MHz */
+}
+
+static phy_interface_t eqos_get_interface_rockchip(const struct udevice *dev)
+{
+	return PHY_INTERFACE_MODE_RMII;
+}
+
+static struct eqos_ops eqos_rockchip_ops = {
+	.eqos_inval_desc = eqos_inval_desc_generic,
+	.eqos_flush_desc = eqos_flush_desc_generic,
+	.eqos_inval_buffer = eqos_inval_buffer_generic,
+	.eqos_flush_buffer = eqos_flush_buffer_generic,
+	.eqos_probe_resources = eqos_probe_resources_rockchip,
+	.eqos_remove_resources = eqos_remove_resources_rockchip,
+	.eqos_stop_resets = eqos_stop_resets_rockchip,
+	.eqos_start_resets = eqos_start_resets_rockchip,
+	.eqos_stop_clks = eqos_stop_clks_rockchip,
+	.eqos_start_clks = eqos_start_clks_rockchip,
+	.eqos_calibrate_pads = eqos_null_ops,
+	.eqos_disable_calibration = eqos_null_ops,
+	.eqos_set_tx_clk_speed = eqos_set_tx_clk_speed_rockchip,
+	.eqos_get_enetaddr = eqos_null_ops,
+	.eqos_get_tick_clk_rate = eqos_get_tick_clk_rate_rockchip,
+};
+
+struct eqos_config __maybe_unused eqos_rockchip_rv1106_config = {
+	.reg_access_always_ok = false,
+	.mdio_wait = 10000,
+	.swr_wait = 50,
+	.config_mac = EQOS_MAC_RXQ_CTRL0_RXQ0EN_ENABLED_DCB,
+	.config_mac_mdio = EQOS_MAC_MDIO_ADDRESS_CR_100_150,
+	.axi_bus_width = EQOS_AXI_WIDTH_64,
+	.interface = eqos_get_interface_rockchip,
+	.ops = &eqos_rockchip_ops,
+};
