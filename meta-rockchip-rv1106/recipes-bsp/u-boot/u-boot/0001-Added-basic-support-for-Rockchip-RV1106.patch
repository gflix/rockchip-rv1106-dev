diff --git a/arch/arm/dts/rv1106-evb.dts b/arch/arm/dts/rv1106-evb.dts
new file mode 100644
index 00000000000..27875a9ae78
--- /dev/null
+++ b/arch/arm/dts/rv1106-evb.dts
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2021 Fuzhou Rockchip Electronics Co., Ltd.
+ * Copyright (c) 2026 Felix Mellmann <flix@benfm.de>
+ */
+
+/dts-v1/;
+
+#include "rv1106.dtsi"
+#include "rv1106-u-boot.dtsi"
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Rockchip RV1106 EVB Board";
+	compatible = "rockchip,rv1106-evb", "rockchip,rv1106";
+
+	adc-keys {
+		compatible = "adc-keys";
+		io-channels = <&saradc 0>;
+		io-channel-names = "buttons";
+		keyup-threshold-microvolt = <1800000>;
+		bootph-all;
+		status = "okay";
+
+		volumeup-key {
+			bootph-all;
+			linux,code = <KEY_VOLUMEUP>;
+			label = "volume up";
+			press-threshold-microvolt = <1750>;
+		};
+	};
+};
+
+&hw_decompress {
+	bootph-pre-ram;
+	status = "okay";
+};
+
+&uart2 {
+	bootph-pre-ram;
+	bootph-all;
+	status = "okay";
+};
+
