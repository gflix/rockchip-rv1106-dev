# Disk layout for Rockchip RV1106
# idbloader at 32K, u-boot at 384K

part idbloader --source rawcopy --sourceparams="file=idbloader.img" --ondisk mmcblk --no-table --align 32
part u-boot --source rawcopy --sourceparams="file=u-boot.img" --ondisk mmcblk --no-table --align 384
part fitimage --source rawcopy --sourceparams="file=fitImage" --ondisk mmcblk --no-table --align 2048
