 arch/arm/boot/dts/rockchip/Makefile       |  3 +
 arch/arm/boot/dts/rockchip/rv1106-evb.dts | 28 +++++++++
 arch/arm/boot/dts/rockchip/rv1106.dtsi    | 70 +++++++++++++++++++++
 arch/arm/configs/rv1106_defconfig         | 77 +++++++++++++++++++++++
 arch/arm/mach-rockchip/Kconfig            | 11 ++++
 arch/arm/mach-rockchip/Makefile           |  1 +
 arch/arm/mach-rockchip/rv1106.c           | 28 +++++++++
 rv1106-fitimage.its                       | 47 ++++++++++++++
 8 files changed, 265 insertions(+)
 create mode 100644 arch/arm/boot/dts/rockchip/rv1106-evb.dts
 create mode 100644 arch/arm/boot/dts/rockchip/rv1106.dtsi
 create mode 100644 arch/arm/configs/rv1106_defconfig
